# ── Helpers ──────────────────────────────────────────────────────────────────

def fmt_time(secs):
    if secs < 0:
        return "--:--"
    m, s = divmod(int(secs), 60)
    h, m = divmod(m, 60)
    return f"{h}h{m:02d}m" if h > 0 else f"{m:02d}:{s:02d}"


def find_root():
    return os.path.dirname(os.path.abspath(__file__))


def step(msg):
    print(f"\n  --> {msg}")


def run(cmd, env=None, cwd=None, capture=False):
    run_env = os.environ.copy()
    if env:
        run_env.update(env)
    if capture:
        result = subprocess.run(cmd, shell=True, env=run_env, cwd=cwd,
                                capture_output=True, text=True)
        if result.returncode != 0:
            raise subprocess.CalledProcessError(
                result.returncode, cmd,
                output=result.stdout, stderr=result.stderr)
        return result
    subprocess.check_call(cmd, shell=True, env=run_env, cwd=cwd)


def r_env():
    r_libs = os.environ.get("R_LIBS_USER",
                            os.path.expanduser("~/R/library"))
    return {"R_LIBS_USER": r_libs}


def run_r_code(code, env=None, cwd=None, label="R script"):
    """Run R code from a temp file instead of inline -e for robustness."""
    with tempfile.NamedTemporaryFile(mode='w', suffix='.R', delete=False) as f:
        f.write(code)
        f.flush()
        tmp_path = f.name
    try:
        result = run(f'Rscript {tmp_path}', env=env, cwd=cwd, capture=True)
        return result
    except subprocess.CalledProcessError as e:
        stderr = getattr(e, 'stderr', '') or ''
        stdout = getattr(e, 'output', '') or ''
        print(f"    ERROR in {label}:")
        if stderr:
            for line in stderr.strip().splitlines()[-5:]:
                print(f"      {line}")
        if stdout:
            for line in stdout.strip().splitlines()[-3:]:
                print(f"      {line}")
        raise
    finally:
        os.unlink(tmp_path)


