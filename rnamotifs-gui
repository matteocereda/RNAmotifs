@APP.route("/run", methods=["POST"])
def start_run():
    # Save uploaded file
    uploaded = request.files.get("input_file")
    if not uploaded or not uploaded.filename:
        return "No file uploaded", 400

    upload_dir = ROOT / "uploads"
    upload_dir.mkdir(exist_ok=True)
    input_path = upload_dir / f"{uuid.uuid4().hex}_{uploaded.filename}"
    uploaded.save(str(input_path))

    # Build command
    f = request.form
    cmd_parts = [
        sys.executable, str(ROOT / "rnamotifs"),
        str(input_path),
        "-n", f.get("name", "analysis"),
        "-g", f.get("genome", "hg19"),
        "-w", f.get("half_window", "15"),
        "-m", f.get("min_height", "4"),
        "-p", f.get("pth", "0.5"),
        "-e", f.get("enrichment_window", "30"),
        "-b", f.get("bootstraps", "10000"),
        "-c", f.get("cores", "4"),
        "--p-fisher", f.get("p_fisher", "0.1"),
        "--p-empirical", f.get("p_empirical", "0.00005"),
        "--top-n", f.get("top_n", "0"),
    ]

    if f.get("from_rmats"):
        cmd_parts += [
            "--from-rmats",
            "--rmats-incl", f.get("rmats_incl", "0.1"),
            "--rmats-fdr", f.get("rmats_fdr", "0.05"),
            "--rmats-constit", f.get("rmats_constit", "0.01"),
            "--rmats-max-constit", f.get("rmats_max_constit", "5000"),
        ]

    # Pipeline steps and their weight in overall progress (must sum to 100)
    STEP_WEIGHTS = {
        "Steps 1-2": (0,  55),   # tetramer search: 0-55%
        "Step 3":     (55, 57),   # organise: 55-57%
        "Step 4":     (57, 67),   # mapping+counting: 57-67%
        "Step 5":     (67, 92),   # bootstrap: 67-92%
        "Step 6":     (92, 100),  # selection: 92-100%
    }

    run_id = uuid.uuid4().hex[:8]
    RUNS[run_id] = {
        "status": "running",
        "run_name": "",
        "progress": 0,
        "total": 100,
        "step": "Starting...",
        "current_step_key": "",
        "log_lines": [],
        "started": datetime.now().isoformat(),
    }

    def update_overall_progress(run, step_done, step_total):
        """Map per-step progress to overall 0-100%."""
        key = run["current_step_key"]
        for prefix, (lo, hi) in STEP_WEIGHTS.items():
            if prefix in key:
                if step_total > 0:
                    frac = step_done / step_total
                else:
                    frac = 0
                run["progress"] = int(lo + frac * (hi - lo))
                return
        # Unknown step — don't update

    def run_pipeline():
        proc = subprocess.Popen(
            cmd_parts, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, cwd=str(ROOT)
        )
        buf = ""
        while True:
            ch = proc.stdout.read(1)
            if not ch:
                break
            if ch == "\n":
                # Full line: split by \r, take last non-empty segment
                parts = buf.split("\r")
                line = parts[-1].strip()
                buf = ""
                if not line:
                    continue

                # Progress lines (\r-overwritten) replace the last log
                # line if it was also a progress line
                is_progress = bool(re.search(
                    r"(PROGRESS|\u2501|\u2578|\u2576|%.*\[)", line))
                log = RUNS[run_id]["log_lines"]
                if is_progress and log and re.search(
                        r"(PROGRESS|\u2501|\u2578|\u2576|%.*\[)", log[-1]):
                    log[-1] = line  # overwrite in place
                else:
                    log.append(line)
                # Keep last 200 lines
                if len(log) > 200:
                    RUNS[run_id]["log_lines"] = log[-200:]

                # Parse step name (-->)
                m2 = re.search(r"-->\s+(.+)", line)
                if m2:
                    step_name = m2.group(1)
                    RUNS[run_id]["step"] = step_name
                    RUNS[run_id]["current_step_key"] = step_name
                    # Set progress to the start of this step
                    for prefix, (lo, hi) in STEP_WEIGHTS.items():
                        if prefix in step_name:
                            RUNS[run_id]["progress"] = lo
                            break

                # Parse PROGRESS lines and map to overall
                m = re.search(r"PROGRESS\s+(\d+)\s+(\d+)", line)
                if m:
                    update_overall_progress(
                        RUNS[run_id], int(m.group(1)), int(m.group(2)))

                # Parse run name from output folder
                m3 = re.search(r"Output\s+:\s+results/(.+)", line)
                if m3:
                    RUNS[run_id]["run_name"] = m3.group(1).strip()

                # Detect completion
                if "RNAmotifs complete" in line:
                    RUNS[run_id]["progress"] = 100

            elif ch == "\r":
                buf += ch
            else:
                buf += ch

        proc.wait()
        RUNS[run_id]["status"] = "complete" if proc.returncode == 0 else "error"
        RUNS[run_id]["progress"] = 100
        # Clean upload
        try:
            input_path.unlink()
        except Exception:
            pass

    t = threading.Thread(target=run_pipeline, daemon=True)
    t.start()

    return redirect(url_for("run_status", run_id=run_id))


@APP.route("/status/<run_id>")
def run_status(run_id):
    if run_id not in RUNS:
        return "Run not found", 404
    r = RUNS[run_id]

    return render_template_string(PAGE_HEAD + """
    <h1><span class="r">R</span><span class="rest">N</span><span class="a">A</span><span class="rest">motifs</span></h1>
    <p class="subtitle"><a href="/">&larr; Back to home</a></p>
  </div>
</div>
<div class="container">

    <div class="card card--{{ 'yellow' if status == 'running' else ('red' if status == 'error' else 'plain') }}" style="display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
        <span class="status-badge status-{{ status }}">{{ status }}</span>
        <span style="font-weight:600;">{{ 'Run in progress' if status == 'running' else ('Run failed' if status == 'error' else 'Run complete') }}</span>
        {% if status == 'running' %}
        <span id="stepLabel" style="color:var(--grey-mid); font-size:0.82rem; margin-left:auto;">{{ step }}</span>
        {% endif %}
    </div>

    {% if status == 'running' or progress < 100 %}
    <div class="progress-wrap">
        <div class="progress-pct" id="progressPct">{{ progress }}%</div>
        <div class="progress-bar-bg">
            <div class="progress-bar-fill" id="progressFill" style="width:{{ progress }}%"></div>
        </div>
        <div class="progress-label">
            <span id="progressStep">{{ step }}</span>
            <span id="progressNum">{{ progress }} / 100</span>
        </div>
    </div>
    {% endif %}

    {% if status == 'complete' and run_name %}
    <div class="btn-row">
        <a href="/results/{{ run_name }}" class="btn btn-primary">View results</a>
    </div>
    {% endif %}

    <div class="log-box" id="logBox">{{ log }}</div>

    {% if status == 'running' %}
    <script>
    function poll() {
        fetch('/api/status/{{ run_id }}')
            .then(r => r.json())
            .then(d => {
                document.getElementById('logBox').textContent = d.log;
                let el = document.getElementById('logBox');
                el.scrollTop = el.scrollHeight;

                // Update progress bar
                let pct = Math.min(d.progress, 100);
                let fill = document.getElementById('progressFill');
                if (fill) {
                    fill.style.width = pct + '%';
                    if (pct >= 100) fill.classList.add('complete');
                }
                let pctEl = document.getElementById('progressPct');
                if (pctEl) pctEl.textContent = pct + '%';
                let numEl = document.getElementById('progressNum');
                if (numEl) numEl.textContent = pct + ' / 100';
                let stepEl = document.getElementById('progressStep');
                if (stepEl) stepEl.textContent = d.step || '';
                let stepLabel = document.getElementById('stepLabel');
                if (stepLabel) stepLabel.textContent = d.step || '';

                if (d.status === 'running') {
                    setTimeout(poll, 1000);
                } else {
                    location.reload();
                }
            });
    }
    setTimeout(poll, 1000);
    </script>
    {% endif %}
    """ + PAGE_FOOT,
        status=r["status"],
        run_name=r["run_name"],
        progress=r["progress"],
        step=r.get("step", ""),
        log="\n".join(r["log_lines"][-100:]),
        run_id=run_id,
    )


@APP.route("/api/status/<run_id>")
def api_status(run_id):
    if run_id not in RUNS:
        return jsonify({"error": "not found"}), 404
    r = RUNS[run_id]
    return jsonify({
        "status": r["status"],
        "progress": r["progress"],
        "total": r["total"],
        "step": r["step"],
        "run_name": r["run_name"],
        "log": "\n".join(r["log_lines"][-100:]),
    })


@APP.route("/results/<run_name>")
def results_page(run_name):
    results_dir = ROOT / "results" / run_name
    if not results_dir.exists():
        return "Results not found", 404

    # File list - grouped by extension
    all_files = sorted(
        [f for f in results_dir.iterdir() if f.is_file() and not f.name.startswith(".")],
        key=lambda f: f.name)
    ext_groups = {}
    ext_labels = {
        ".pdf": "Plots (PDF)",
        ".csv": "Tables (CSV)",
        ".tsv": "Tables (TSV)",
        ".log": "Logs",
        ".txt": "Text files",
    }
    for f in all_files:
        ext = f.suffix.lower() if f.suffix else "(other)"
        ext_groups.setdefault(ext, []).append(f)
    # Order: PDF first, then CSV, TSV, then rest
    ext_order = [".pdf", ".csv", ".tsv", ".log", ".txt"]
    ordered_exts = [e for e in ext_order if e in ext_groups]
    ordered_exts += [e for e in ext_groups if e not in ordered_exts]

    files_html = ""
    for ext in ordered_exts:
        label = ext_labels.get(ext, ext.upper().lstrip('.') + " files")
        files_html += f'<li class="file-group-label">{label}</li>'
        for f in ext_groups[ext]:
            size = f.stat().st_size
            if size > 1_000_000:
                size_str = f"{size / 1_000_000:.1f} MB"
            elif size > 1000:
                size_str = f"{size / 1000:.1f} KB"
            else:
                size_str = f"{size} B"
            files_html += f"""<li>
                <a href="/results/{run_name}/file/{f.name}" target="_blank">{f.name}</a>
                <span class="file-size">{size_str}</span>
            </li>"""

    # Build tabbed PDF interface — known PDFs with friendly names, plus any extras
    pdf_known = {
        "structure_profile.pdf":            "Structure Profile",
        "structure_cluster_profile.pdf":    "Structure Clusters",
        "conservation_profile.pdf":         "Conservation Profile",
        "conservation_cluster_profile.pdf": "Conservation Clusters",
    }
    active_tabs = []
    seen_pdfs = set()
    # RNA Splicing Map first
    mrm_pdfs = list(results_dir.glob("MRMs_*.pdf"))
    if mrm_pdfs:
        active_tabs.append(("RNA Splicing Map", mrm_pdfs[0]))
        seen_pdfs.add(mrm_pdfs[0].name)
    # Known PDFs in order
    for fname, label in pdf_known.items():
        p = results_dir / fname
        if p.exists():
            active_tabs.append((label, p))
            seen_pdfs.add(fname)
    # Any other PDFs not yet listed
    for p in sorted(results_dir.glob("*.pdf")):
        if p.name not in seen_pdfs and not p.name.startswith("."):
            # Generate label from filename
            label = p.stem.replace("_", " ").replace("-", " ").title()
            active_tabs.append((label, p))
            seen_pdfs.add(p.name)

    pdf_embed = ""
    if active_tabs:
        pdf_embed = '<h2>Results</h2><div class="pdf-tabs"><div class="tab-bar">'
        for i, (label, _) in enumerate(active_tabs):
            active_cls = " active" if i == 0 else ""
            pdf_embed += f'<button class="tab-btn{active_cls}" onclick="switchTab(event, \'tab-{i}\')">{label}</button>'
        pdf_embed += '</div>'
        for i, (label, pdf_path) in enumerate(active_tabs):
            active_cls = " active" if i == 0 else ""
            pdf_url = f"/results/{run_name}/file/{pdf_path.name}"
            pdf_embed += f'''
            <div class="tab-panel{active_cls}" id="tab-{i}">
                <div class="pdf-frame">
                    <object data="{pdf_url}" type="application/pdf"
                            width="100%" height="700px">
                        <p style="padding:2rem; text-align:center;">PDF cannot be displayed.
                           <a href="{pdf_url}" target="_blank">Open PDF</a></p>
                    </object>
                </div>
            </div>'''
        pdf_embed += '</div>'
        pdf_embed += '''
        <script>
        function switchTab(evt, tabId) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            evt.currentTarget.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        }
        </script>'''

    # Enriched tetramers table (full CSV rendered as HTML table)
    csvs = list(results_dir.glob("MRMs_*.csv"))
    table_html = ""
    if csvs:
        import csv as csvmod
        with open(csvs[0]) as cf:
            reader = csvmod.reader(cf)
            header = next(reader)
            rows = list(reader)

        # Separate significant from non-significant
        sig_rows = [r for r in rows if len(r) > 3 and r[3] == "TRUE"]
        other_rows = [r for r in rows if len(r) > 3 and r[3] != "TRUE"]

        if sig_rows or other_rows:
            n_sig = len(sig_rows)
            n_total = len(rows)
            table_html = f'<h2>Enriched tetramers ({n_sig} significant / {n_total} total)</h2>'
            table_html += '<div class="results-table-wrap"><table class="results-table">'

            # Header
            table_html += "<thead><tr>"
            for h in header:
                table_html += f'<th>{h}</th>'
            table_html += "</tr></thead><tbody>"

            # Significant rows (highlighted)
            for r in sig_rows:
                table_html += '<tr class="sig-row">'
                for i, c in enumerate(r):
                    cls = ""
                    if i == 0:
                        cls = ' class="sig-name"'
                    else:
                        try:
                            v = float(c)
                            if v <= 0.05:
                                cls = ' class="sig-pval"'
                        except ValueError:
                            pass
                    table_html += f'<td{cls}>{c}</td>'
                table_html += "</tr>"

            # Non-significant rows
            for r in other_rows:
                table_html += "<tr>"
                for c in r:
                    table_html += f'<td class="muted-cell">{c}</td>'
                table_html += "</tr>"

            table_html += "</tbody></table></div>"

    # Bootstrap results summary
    bootstrap_files = list(results_dir.glob("bootstrap_*.tsv"))
    boot_html = ""
    if bootstrap_files:
        import csv as csvmod
        with open(bootstrap_files[0]) as bf:
            reader = csvmod.DictReader(bf, delimiter="\t")
            boot_rows = list(reader)
        n_boot = len(boot_rows)
        # Count how many have any pEmp < 0.05
        n_sig_boot = sum(1 for r in boot_rows
            if any(float(r.get(c, 1)) < 0.05
                   for c in r if c.endswith("_pEmp")))
        boot_html = f"""
        <div class="card" style="margin-bottom:1.5rem;">
            <h3>Bootstrap summary</h3>
            <p style="color:var(--grey-mid); font-size:0.85rem;">
                {n_boot} tetramers tested &middot;
                {n_sig_boot} with empirical p &lt; 0.05 in at least one region
            </p>
            <a href="/results/{run_name}/file/{bootstrap_files[0].name}" target="_blank"
               class="btn btn-secondary" style="margin-top:0.8rem; font-size:0.8rem;">
                View full bootstrap table</a>
        </div>"""

    return render_template_string(PAGE_HEAD + """
    <h1><span class="r">R</span><span class="rest">N</span><span class="a">A</span><span class="rest">motifs</span></h1>
    <p class="subtitle"><a href="/">&larr; Back</a> &middot; <strong>{{ run_name }}</strong></p>
  </div>
</div>
<div class="container">

    {{ pdf_embed | safe }}
    {{ boot_html | safe }}
    {{ table_html | safe }}

    <h2>Output files</h2>
    <ul class="file-list">
    {{ files_html | safe }}
    </ul>
    """ + PAGE_FOOT,
        run_name=run_name,
        pdf_embed=pdf_embed,
        boot_html=boot_html,
        table_html=table_html,
        files_html=files_html,
    )


@APP.route("/results/<run_name>/file/<filename>")
def serve_file(run_name, filename):
    """Serve files inline (not as download) with correct MIME type."""
    results_dir = ROOT / "results" / run_name
    filepath = results_dir / filename
    if not filepath.exists():
        return "File not found", 404

    mime_types = {
        ".pdf": "application/pdf",
        ".tsv": "text/tab-separated-values",
        ".csv": "text/csv",
        ".txt": "text/plain",
        ".log": "text/plain",
    }
    mime = mime_types.get(filepath.suffix, "application/octet-stream")

    # For text files, serve inline so browser displays them
    response = send_from_directory(str(results_dir), filename, mimetype=mime)
    if mime.startswith("text/") or mime == "application/pdf":
        response.headers["Content-Disposition"] = f"inline; filename={filename}"
    return response


